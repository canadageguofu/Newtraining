<!DOCTYPE html>
<html>
<head>
    <title>Register Course</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-1.12.4.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <style>
        /* Optional: Minor card shadow and spacing tweaks */
        .card { box-shadow: 0 2px 16px rgba(0,0,0,0.07); }
        .legend-title { font-size: 1.1rem; font-weight: bold; color: #495057;}
        label { font-weight: 500; }
        .form-group { margin-bottom: 1.3rem; }
        .form-control:disabled, .form-control[readonly] { background: #f5f5f5; }
    </style>
</head>
<body>
    {{> header user}}
    <div class="container py-5" style="max-width: 600px;">
        <h2 class="mb-4 text-primary fw-bold">
            <i class="bi bi-journal-plus"></i> Register for a Course
        </h2>
        <div class="card mb-3">
            <div class="card-body">
                <form method="post" action="/course/reg" autocomplete="off">
                    <!-- Student and Course Selection -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Student Id</label>
                            <input class="form-control" name="studentId" type="text" required autocomplete="student-id" value = "{{studentId}}"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Select Course</label>
                            {{#if courses}}
                                <select class="form-select" name="course" id="course" onchange="course_changed()" required>
                                    <option value="">Choose a course...</option>
                                    {{#each courses}}
                                        <option value="{{courseId}}" {{#if selected}} selected {{/if}}>{{courseName}}</option>
                                    {{/each}}
                                </select>
                            {{else}}
                                <div class="alert alert-info mb-0" role="alert">
                                    <i class="bi bi-emoji-frown"></i> No courses available for registration.
                                </div>
                            {{/if}}
                        </div>
                    </div>
                    <!-- Course Info Auto-fill -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course Id</label>
                            <input class="form-control" name="courseId" id="courseId" type="text" readonly/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course Price</label>
                            <input class="form-control" id="coursePrice" name="coursePrice" type="text" readonly/>
                        </div>
                        <!-- Hidden All Courses JSON -->
                        <div hidden>
                            <input class="form-control" name="AllCourses" id="AllCourses" type="text" value="{{strcourses}}"/>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-lg"></i> Register
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Optionally, you can place a list of available courses below -->
        <!--
        {{#if courses.length}}
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Available Courses</h5>
                <ul class="list-group list-group-flush">
                {{#each courses}}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{courseName}} <span class="text-muted small">({{courseId}})</span></span>
                        <span class="badge bg-secondary rounded-pill">${{coursePrice}}</span>
                    </li>
                {{/each}}
                </ul>
            </div>
        </div>
        {{/if}}
        -->
    </div>

    <!-- JavaScript for autofill -->
    <script type="text/javascript">
    function course_changed() {
        var e = document.getElementById('course');
        if (!e) return;
        var cvalue = e.value;
        var allCourses = document.getElementById('AllCourses').value;
        var aC = JSON.parse(allCourses || "[]");
        for(let i=0; i < aC.length; i++){
            if (aC[i].courseId == cvalue){
                document.getElementById('courseId').value = cvalue;
                document.getElementById('coursePrice').value = aC[i].coursePrice;
                break;
            }
        }
    }

    window.addEventListener('DOMContentLoaded', function () {
        var courseSelect = document.getElementById('course');
        if (!courseSelect) return;
        // If there's only one real course, auto-select it
        if (courseSelect.options.length === 2) {
            courseSelect.selectedIndex = 1;
            course_changed();
        }
    });
    </script>
    {{> footer}}
</body>
</html>