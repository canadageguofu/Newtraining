<!DOCTYPE html>
<html>
    <head>
        <title>Students</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
        <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
        <script src="https://code.jquery.com/jquery-1.12.4.js"></script>
        <link rel="stylesheet" href="/css/theme.css">
        <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    </head>
    <body>
        {{> header user}}

        <div class="container">
            <br/>
            <h1>Students</h1>
            <br>

            {{#if user.isManager}}
            <nav class="navbar navbar-light bg-light">
                <div class="container-fluid">
                    <form class="d-flex" method="post" action="/student/search">
                        <input class="form-control me-2 col-md-6" type="text" placeholder="Enter Student Number" aria-label="Search" name="S_studentId">
                        <button class="btn btn-info" type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </button>
                    </form>
                    <a href="/students/add"><button type="button" class="btn btn-success">Add Student</button></a>
                </div>
            </nav>
            <br>
            <div class = "table-responsive">
                <table class = "table" border-collapse = "collapse" border-color = "red" border = "5px solid" width="auto" id=tab1> 
                    <thead bgcolor="darkblue" style="color: white; text-transform:uppercase; text-align: center;vertical-align: middle;font-size: 0.875rem;" >  
                        <tr>
                            <th>Number</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Education</th>
                            <th>Graduate School</th>
                            <th>Status</th>
                            <th>Enroll Date</th>
                            {{!-- <th>Start Date</th> --}}
                            <th>End Date</th>
                            <th class="text-nowrap">Options</th>
                            {{!-- <th>Options</th> --}}
                        </tr>
                    </thead>
                    {{#each students}}
                    <tr>
                        <td>{{studentId}}</td>
                        <td>{{studentName}}</td>
                        <td>{{email}}</td>
                        <td>{{addressStreet}}, {{addressCity}}, {{addressState}} {{addressPostal}}</td>
                        <td>{{education}}</td>
                        <td>{{graduateSchool}}</td>
                        <td>{{status}}</td>
                        <td>{{enrollDate}}</td>
                        {{!-- <td>{{startDate}}</td> --}}
                        <td>{{endDate}}</td>
                        {{!-- <td class="buttonlink">
                            <a href = "/student_courses?studentId={{studentId}}" >
                                <button class = "btn btn-info">Courses List</button>
                            </a>
                            <a href="/students/{{studentId}}">
                                <button class = "btn btn-warning">Update</button>
                            </a>
                            <a href="/students/delete/{{studentId}}">
                                <button class = "btn btn-danger">Remove</button>
                            </a>
                        </td> --}}
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/student_courses?studentId={{studentId}}" class="btn btn-info btn-sm">Courses List</a>
                                <a href="/students/{{studentId}}" class="btn btn-warning btn-sm">Update</a>
                                <a href="/students/delete/{{studentId}}" class="btn btn-danger btn-sm">Remove</a>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </table>
            </div>  
            <script language="javascript">  
                var a = document.all.tab1.getElementsByTagName("tr");
                                    for (var i = 1; i < a.length; i++) {
                                        a[i].style.background = (i % 2 == 1) ? "#C0C0C0" : "#FFFFFF";
                                    }
            </script>
            {{#unless students}}
                <div class="text-center">
                    <strong>{{message}}</strong>
                </div>
            {{/unless}}
            {{else}}
                <p class="errorMsg">You are not authorized to see this page.</p>
            {{/if}}

        </div>
        
        {{> footer}}
    </body>

</html>